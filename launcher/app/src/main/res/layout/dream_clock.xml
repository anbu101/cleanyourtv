<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Photo frame backdrop; GONE when no photos are found. -->
    <ImageView
        android:id="@+id/dreamPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Weather backdrop in screensaver; GONE when weather background is off. -->
    <com.gathin.tvhome.WeatherView
        android:id="@+id/dreamWeather"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="52sp"
                android:fontFamily="@font/outfit_light"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="8dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- Synced lyrics in screensaver; same settings as the home screen. -->
    <com.gathin.tvhome.LyricsView
        android:id="@+id/dreamLyrics"
        android:layout_width="416dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
